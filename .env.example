# VULNEX AI Environment Configuration

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Reasoning Engine (Optional - VULNEX includes deterministic fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database Configuration (Optional - VULNEX includes zero-config SQLite persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Upload Boundaries
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
