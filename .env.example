# VULNEX AI - Unified Project Environment Configuration
# Single source of truth for all services (backend + frontend).
# Copy to .env and fill in real values before running. .env is gitignored.

# ============================================
# Backend (Python/FastAPI) - renders on Render
# ============================================
PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Frontend (Next.js) - renders on Vercel
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
